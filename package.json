{
  "name": "hnl-structural-ai-workstation",
  "private": true,
  "version": "1.3.2",
  "description": "HNL Structural AI Workstation for ETABS, SAP2000 and SAFE",
  "author": "HNL",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "vn.hnl.structuralai",
    "productName": "HNL Structural AI Workstation",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "assets/hnl-app.png",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/hnl-app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HNL Structural AI",
      "deleteAppDataOnUninstall": false,
      "artifactName": "HNL-Structural-AI-Setup-${version}-${arch}.${ext}",
      "installerIcon": "assets/hnl-app.ico",
      "uninstallerIcon": "assets/hnl-app.ico",
      "installerHeaderIcon": "assets/hnl-app.ico"
    },
    "publish": null,
    "portable": {
      "artifactName": "HNL-Structural-AI-Portable-${version}-${arch}.${ext}"
    }
  }
}
